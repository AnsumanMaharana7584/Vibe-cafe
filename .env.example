# PhonePe Payment Gateway (https://developer.phonepe.com/)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=SANDBOX

# Optional: for server-to-server webhook verification
PHONEPE_CALLBACK_USERNAME=
PHONEPE_CALLBACK_PASSWORD=

# Copy this file to .env and add your PhonePe credentials from the PhonePe Business dashboard.
# Leave PHONEPE_CLIENT_ID blank to use demo payment mode during development.
